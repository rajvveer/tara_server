NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/set_a_goal?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=onward-api
JWT_AUDIENCE=onward-app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional public URL used by deployment metadata and reset-email integrations.
APP_URL=http://localhost:4000

# Production password reset delivery (Resend HTTPS API).
RESEND_API_KEY=
RESET_FROM_EMAIL=Onward <reset@example.com>

# Firebase service-account JSON, kept in the deployment secret store.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local alternative to embedding JSON. Keep the referenced file outside source control.
FIREBASE_SERVICE_ACCOUNT_FILE=
# Protects the Vercel maintenance cron endpoint. Use at least 16 random characters.
CRON_SECRET=

# Sarvam voice onboarding. Keep this server-side; never expose it to Flutter/web.
SARVAM_API_KEY=

# Groq-hosted GPT-OSS 120B for voice-onboarding reasoning and goal extraction.
GROQ_API_KEY=

# Google OAuth client IDs accepted in the ID token audience (comma-separated).
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Sign in with Apple: native iOS uses the bundle ID; Android/web use the Services ID and redirect URI.
APPLE_BUNDLE_ID=com.example.onward
APPLE_SERVICE_ID=com.example.onward.web
APPLE_TEAM_ID=YOURTEAMID
APPLE_KEY_ID=YOURKEYID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_P8_KEY\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://api.example.com/api/v1/auth/apple/callback
APPLE_ANDROID_PACKAGE=com.intentional.onward
